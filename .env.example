# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# Hostzens.com Managed PostgreSQL Database Configuration
HOSTZEN_API_URL="https://hostzens.com/api"
HOSTZEN_PROJECT_ID="YOUR_HOSTZEN_PROJECT_ID"
HOSTZEN_API_KEY="YOUR_HOSTZEN_USER_API_KEY"
# Optional: project service_role key for Hostzens Storage (server-only, never expose to the browser)
HOSTZEN_SERVICE_KEY="YOUR_HOSTZEN_SERVICE_ROLE_KEY"

# Session signing secret (use a long random string in production)
SESSION_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET"

# Optional Google Maps Platform API Key (server-side geocoding & interactive Contact map)
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Optional SMTP settings for live email delivery (notifications are also logged in Hostzens DB)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NIEM Admissions <info@smnie.in>"
